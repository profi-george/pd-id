// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  BACKLOG // в бэклоге
  PLANNED // запланирована
  DONE // выполнена
  NOT_DONE // не выполнена
  MOVED // перенесена (заменена копией на другой день)
}

// Кабинет — отдельный пользователь со своими проектами/задачами/днями и своим
// Google-календарём. Вход по имени кабинета + PIN (см. src/lib/auth.ts).
model User {
  id        String   @id @default(cuid())
  name      String   @unique
  pinHash   String
  pinSalt   String
  createdAt DateTime @default(now())

  projects Project[]
  tasks    Task[]
  days     Day[]
  settings AppSettings?
}

model Project {
  id       String  @id @default(cuid())
  name     String
  parentId String?
  parent   Project? @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Project[] @relation("ProjectHierarchy")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id        String   @id @default(cuid())
  text      String // краткое название действия
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  urgency Int // срочность 1-5

  resultText     String? // ожидаемый результат
  motivationText String? // мотивация — контекст, на score не влияет

  value              Int     @default(3) // ценность результата 1-5
  costOfDelay        Int     @default(3) // цена откладывания 1-5
  timeSensitivity    Int     @default(3) // временная чувствительность 1-5
  goalAlignment      Int     @default(3) // связь с текущей целью 1-5
  effortMinutes      Int     @default(30) // затраты в минутах
  alternativeQuality Float   @default(0) // 0..1, есть ли равноценная альтернатива
  confidence         Float   @default(0.6) // 0..1, уверенность оценки

  deadline             DateTime? // жёсткий срок (не путать с датой плана)
  financialConsequence Boolean   @default(false)

  primaryReason String? // главная причина такого приоритета (человеческим языком)
  riskText      String? // риск отложить
  note          String? // свободная заметка пользователя — подход к выполнению, зацепки, что учесть

  // Исходные оценки AI "как есть" — сохраняются на момент создания, чтобы можно было
  // сравнить с текущим значением (после ручной правки) и показать "Изменено вручную".
  aiValue           Int?
  aiCostOfDelay     Int?
  aiUrgency         Int?
  aiTimeSensitivity Int?
  aiEffortMinutes   Int?

  // Объяснение AI по каждому критерию — для tooltip "почему именно такая оценка".
  aiReasoningValue           String?
  aiReasoningCostOfDelay     String?
  aiReasoningUrgency         String?
  aiReasoningTimeSensitivity String?
  aiReasoningEffort          String?

  manualPriority String? // P0 | P1 | P2 | P3 | LATER — если задано, перекрывает расчёт AI
  manualRank     Int?    // ручной порядок внутри группы приоритета (drag&drop); null = сортировать по score AI
  confidenceReason String? // короткое объяснение AI, почему уверенность не высокая

  googleEventId  String? // id события в Google Calendar, если задача туда добавлена
  googleEventUrl String? // прямая ссылка на событие

  date   DateTime? // дата, на которую запланирована; null = бэклог
  status TaskStatus @default(BACKLOG)
  // Если задачу перенесли/убрали из плана дня НЕ через "Итог дня" (кнопкой "На завтра"
  // и т.п.), эта запись получает status=MOVED и остаётся при своей исходной date —
  // так "Итог дня" того дня всё ещё может показать "перенесена → сюда", а не просто
  // молча потерять задачу. Сама задача продолжается отдельной новой записью.
  movedToDate DateTime?
  // id исходной задачи, если эта запись — копия, созданная переносом (см. movedToDate
  // выше). Обратная связь нужна, чтобы можно было отменить перенос: найти копию по
  // этому полю и убедиться, что её ещё не трогали, прежде чем откатывать оригинал.
  movedFromTaskId String?
  order  Int        @default(0) // ручной порядок внутри дня

  score Int? // оценка выполнения 0-10, заполняется вечером
  whySucceeded String? // почему получилось — заполняется в Итоге дня для этой конкретной задачи
  whyFailed    String? // почему не получилось — заполняется в Итоге дня для этой конкретной задачи

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @id
  currentGoal String? // текущая главная цель — контекст для оценки goalAlignment

  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleAccountEmail String? // для отображения "подключено как ..."
}

model Day {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  date   DateTime

  whyWorked    String? // почему получилось
  whyNotWorked String? // почему не получилось

  difficulty   Int? // трудность дня 1-10
  mood         Int? // настроение 1-10
  efficiency   Int? // эффективность 1-10
  worry        Int? // переживания 1-10

  conclusion String? // вывод на завтра

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}
